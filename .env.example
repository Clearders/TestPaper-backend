# Development quick start. Copy to .env; never commit .env.
TESTPAPERS_ENV=development
DATABASE_URL=postgresql+psycopg://testpapers:testpapers-local-only@localhost:5432/testpapers
DATA_DIR=.runtime
API_HOST=127.0.0.1
API_PORT=8000
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/1
CELERY_RESULT_BACKEND=redis://localhost:6379/1
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
TRUSTED_HOSTS=localhost,127.0.0.1
FORWARDED_ALLOW_IPS=127.0.0.1
AUTH_COOKIE_SECURE=false
AUTH_COOKIE_SAMESITE=lax

# Configure all four object-storage values together or leave all four empty.
OBJECT_STORAGE_ENDPOINT=
OBJECT_STORAGE_BUCKET=
OBJECT_STORAGE_ACCESS_KEY=
OBJECT_STORAGE_SECRET_KEY=
OBJECT_STORAGE_SECURE=false

# --- Docker Compose (testpapers-cloud) settings ---------------------------
# Read by compose.yaml in this repository. Copy this file to .env at the repo
# root and adjust before `docker compose up`. All host ports bind to 127.0.0.1.
POSTGRES_DB=testpapers
POSTGRES_USER=testpapers
POSTGRES_PASSWORD=testpapers-local-only
POSTGRES_PORT=5432
API_PORT=8000
WEB_PORT=3000
REDIS_PORT=6379
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001
MINIO_ROOT_USER=testpapers-local
MINIO_ROOT_PASSWORD=testpapers-local-only

# Path to the TestPapers web checkout used to build the `web` service. It must
# be an independently checked-out repository (no cross-repo relative paths).
WEB_CONTEXT=../TestPapers
